      "Bash(echo \"---EXIT $?\")",
      "Bash(xargs sed -i \"s/tone=\\\\\"clay\\\\\"/tone=\\\\\"brand\\\\\"/g; s/tone: 'clay'/tone: 'brand'/g; s/'clay' : 'neutral'/'ember' : 'neutral'/g\")",
      "Bash(sed -i \"s/  clay: 'bg-brand-100 text-brand-700',/  brand: 'bg-brand-50 text-brand-600',\\\\n  ember: 'bg-ember-50 text-ember-700',/\" components/ui/Badge.jsx)",
      "Bash(grep -vE \"^\\\\s*$\")",
      "Bash(grep -rn *)",
      "Bash(grep -n *)",
      "Bash(grep -E \"^C:\\\\\\\\\\\\\\\\\")",
      "Bash(curl -s \"http://localhost:5000/api/v1/cities?limit=1\")",
      "Bash(curl -s \"http://localhost:5000/api/v1/activities?limit=1\")",
      "Bash(curl -s \"http://localhost:5000/api/v1/public/trips?limit=1\")",
