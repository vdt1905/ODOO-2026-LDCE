# FastAPI
PORT=8000
# Comma-separated origins allowed to call this service (add the AI/frontend origin
# and, later, the main frontend/backend origins when they start calling in)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://localhost:5173

# MongoDB — point this at the SAME Atlas cluster/database the Node backend uses
# (see backend/.env: MONGO_URI). This service only reads cities/activities/trips/stops
# and writes to its own "ai_suggestion_logs" collection, so it's safe to share the DB.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/globetrotter?retryWrites=true&w=majority
MONGO_DB_NAME=globetrotter

# Sarvam AI — https://dashboard.sarvam.ai (API key / subscription key)
# Used ONLY for language identification (/text-lid) so suggestions come back in the
# language the user typed in. Suggestion generation itself runs on Groq (below).
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Groq — https://console.groq.com/keys — runs suggestion generation.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-20b
