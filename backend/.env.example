NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string — include the database name before the query string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/globetrotter?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Origin allowed by CORS and used for the refresh cookie
CLIENT_URL=http://localhost:5173

# Cloudinary — Dashboard → Product Environment Credentials (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=globetrotter
UPLOAD_MAX_MB=5

# Gemini — https://aistudio.google.com/apikey  (server-side only, never expose to the browser)
# The planner runs on either backend — set ONE of the two keys below.
# Whichever is present wins (Gemini first); AI_PROVIDER forces the choice.
# GROQ_* mirror AI/.env on purpose, so one key powers the assistant and the
# planner. With neither set, /ai/status reports available:false and the UI
# hides the entry point instead of offering a button that always fails.
AI_PROVIDER=
AI_TIMEOUT_MS=30000

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
