NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string — include the database name before the query string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/globetrotter?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Origin allowed by CORS and used for the refresh cookie
CLIENT_URL=http://localhost:5173
